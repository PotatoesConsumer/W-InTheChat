{
  "name": "w-inthechat",
  "version": "0.1.0",
  "description": "A web-based streamer simulator with a real-time, AI-powered audience.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.js",
    "ai:demo": "node src/ai/demo.js",
    "ai:personas": "node scripts/persona-trial.js",
    "ai:voice": "node scripts/voice-trial.js",
    "pilot": "node scripts/pilot.js",
    "benchmark": "node scripts/benchmark.js",
    "service": "node scripts/service.js",
    "e2e": "node scripts/e2e.js",
    "harness": "node scripts/harness.js",
    "regression": "node scripts/regression.js",
    "study:order": "node scripts/study-order.js",
    "study:rating-sheet": "node scripts/study-rating-sheet.js",
    "study:analyze": "node scripts/study-analyze.js",
    "eval:runs": "node scripts/eval-runs.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
